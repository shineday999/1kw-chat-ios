<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="1kw Chat" />
<meta name="theme-color" content="#ec4899" />
<link rel="manifest" href="/manifest.json" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<title>1kw Chat</title>
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; padding: 0; height: 100%; width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang TC", "Microsoft JhengHei", sans-serif;
    background: linear-gradient(135deg, #fdf2f8 0%, #fff7ed 50%, #fefce8 100%);
    color: #1f2937; overflow: hidden;
    overscroll-behavior: none;
  }
  #app {
    display: flex; flex-direction: column;
    height: 100vh; height: 100dvh;
    max-width: 720px; margin: 0 auto;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }
  header {
    flex: 0 0 auto;
    padding: 12px 16px;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(236,72,153,0.15);
    display: flex; align-items: center; gap: 10px;
  }
  header h1 {
    margin: 0; font-size: 18px; font-weight: 700;
    background: linear-gradient(135deg, #ec4899 0%, #fb923c 50%, #fbbf24 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  #status {
    margin-left: auto; font-size: 11px;
    padding: 3px 10px; border-radius: 999px;
    background: linear-gradient(135deg, #fce7f3, #fed7aa); color: #be185d;
  }
  #status.online { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #047857; }
  #status.offline { background: linear-gradient(135deg, #fee2e2, #fecaca); color: #b91c1c; }
  #settings {
    flex: 0 0 auto; padding: 10px 16px;
    background: rgba(255,255,255,0.5);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    font-size: 13px;
  }
  #settings label { color: #6b7280; font-size: 12px; }
  #settings select, #settings input[type="number"], #settings input[type="text"] {
    border: 1px solid #fbcfe8; border-radius: 8px;
    padding: 5px 8px; font-size: 13px; background: white;
    font-family: inherit;
  }
  #settings input[type="text"] { width: 220px; }
  #settings input[type="number"] { width: 60px; }
  #settings button {
    border: none; border-radius: 8px;
    padding: 5px 12px; font-size: 12px;
    background: linear-gradient(135deg, #fce7f3, #fed7aa);
    color: #be185d; font-weight: 600; cursor: pointer;
  }
  #settings button:hover { transform: translateY(-1px); }
  #settings details { width: 100%; }
  #settings summary { cursor: pointer; color: #be185d; font-size: 12px; padding: 2px 0; }
  #settings details[open] summary { margin-bottom: 6px; }
  .adv-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 4px; }

  #messages {
    flex: 1 1 auto; overflow-y: auto; -webkit-overflow-scrolling: touch;
    padding: 12px 16px; display: flex; flex-direction: column; gap: 10px;
  }
  .msg {
    max-width: 88%; padding: 10px 14px; border-radius: 18px;
    line-height: 1.5; font-size: 15px;
    white-space: pre-wrap; word-wrap: break-word;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }
  .msg.user {
    align-self: flex-end;
    background: linear-gradient(135deg, #ec4899 0%, #fb923c 100%);
    color: white; border-bottom-right-radius: 6px;
  }
  .msg.assistant {
    align-self: flex-start;
    background: white; color: #1f2937; border-bottom-left-radius: 6px;
  }
  .msg.error { align-self: flex-start; background: #fee2e2; color: #b91c1c; }
  .msg.system { align-self: center; background: rgba(0,0,0,0.05); color: #6b7280; font-size: 12px; padding: 6px 12px; }
  .msg.thinking { color: #9ca3af; font-style: italic; }
  .msg pre { margin: 0; white-space: pre-wrap; }

  #composer {
    flex: 0 0 auto;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom)) 12px;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(236,72,153,0.15);
    display: flex; gap: 8px; align-items: flex-end;
  }
  #input {
    flex: 1; border: 1px solid #fbcfe8; border-radius: 18px;
    padding: 10px 14px; font-size: 15px; font-family: inherit;
    background: white; color: #1f2937;
    resize: none; max-height: 140px; min-height: 42px;
    outline: none;
  }
  #input:focus { border-color: #ec4899; box-shadow: 0 0 0 3px rgba(236,72,153,0.15); }
  #send {
    flex: 0 0 auto; width: 42px; height: 42px; border: none; border-radius: 50%;
    background: linear-gradient(135deg, #ec4899 0%, #fb923c 100%);
    color: white; font-size: 20px; cursor: pointer;
    box-shadow: 0 4px 12px rgba(236,72,153,0.3);
    display: flex; align-items: center; justify-content: center;
  }
  #send:disabled { opacity: 0.4; cursor: not-allowed; }
  #send:hover:not(:disabled) { transform: translateY(-1px); }
  #clear {
    background: none; border: none; color: #9ca3af; font-size: 13px;
    cursor: pointer; padding: 4px 8px;
  }
  .streaming-cursor::after { content: "▍"; animation: blink 1s infinite; color: #ec4899; }
  @keyframes blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }
</style>
</head>
<body>
<div id="app">
  <header>
    <h1>1kw Chat</h1>
    <span id="status">連線中…</span>
  </header>

  <div id="settings">
    <label>API:</label>
    <input id="api-url" type="text" placeholder="http://100.117.83.39:8082/v1" />
    <label>Key:</label>
    <input id="api-key" type="text" placeholder="(可選)" style="width:140px;" />
    <button id="save">儲存</button>
    <button id="clear">清對話</button>
    <details>
      <summary>進階 (模型/參數)</summary>
      <div class="adv-row">
        <label>模型:</label>
        <input id="model" type="text" placeholder="(自動抓 /v1/models)" style="width:180px;" />
        <label>temp</label><input id="temp" type="number" step="0.05" min="0" max="2" value="0.6" />
        <label>top-p</label><input id="topp" type="number" step="0.05" min="0" max="1" value="0.95" />
        <label>max</label><input id="max" type="number" step="64" min="64" value="4096" />
      </div>
      <div class="adv-row" style="margin-top:6px;">
        <label style="flex-basis:100%;">System:</label>
        <textarea id="system" rows="2" style="flex:1; border:1px solid #fbcfe8; border-radius:8px; padding:6px; font-size:13px; font-family:inherit;">你是 1kw 的本地助手，回答簡潔。</textarea>
      </div>
    </details>
  </div>

  <div id="messages"></div>

  <div id="composer">
    <textarea id="input" placeholder="輸入訊息… (Shift+Enter 換行)" rows="1"></textarea>
    <button id="send" aria-label="送出">▶</button>
  </div>
</div>

<script>
(() => {
  // -------- State --------
  const LS = (k, d) => { try { return JSON.parse(localStorage.getItem(k)) ?? d; } catch { return d; } };
  const SS = (k, v) => localStorage.setItem(k, JSON.stringify(v));

  let cfg = LS("1kw-chat-cfg", {
    apiUrl: "http://100.117.83.39:8082/v1",
    apiKey: "qwen_local_access",
    model: "",
    temp: 0.6,
    topp: 0.95,
    max: 4096,
    system: "你是 1kw 的本地助手，回答簡潔。",
  });
  let messages = LS("1kw-chat-msgs", []); // [{role, content}]
  let models = [];
  let streaming = false;

  // -------- Elements --------
  const $ = (id) => document.getElementById(id);
  const apiUrl = $("api-url"), apiKey = $("api-key"), modelEl = $("model"),
        tempEl = $("temp"), toppEl = $("topp"), maxEl = $("max"), sysEl = $("system"),
        saveBtn = $("save"), clearBtn = $("clear"),
        sendBtn = $("send"), inputEl = $("input"),
        msgEl = $("messages"), statusEl = $("status");

  function loadCfg() {
    apiUrl.value = cfg.apiUrl; apiKey.value = cfg.apiKey; modelEl.value = cfg.model;
    tempEl.value = cfg.temp; toppEl.value = cfg.topp; maxEl.value = cfg.max; sysEl.value = cfg.system;
  }
  function renderMessages() {
    msgEl.innerHTML = "";
    if (messages.length === 0) {
      const div = document.createElement("div");
      div.className = "msg system";
      div.textContent = "說點什麼吧 ✨";
      msgEl.appendChild(div);
      return;
    }
    for (const m of messages) msgEl.appendChild(renderMsg(m));
    msgEl.scrollTop = msgEl.scrollHeight;
  }
  function renderMsg(m) {
    const div = document.createElement("div");
    div.className = "msg " + (m.role === "user" ? "user" : m.role === "assistant" ? "assistant" : m.role === "error" ? "error" : "system");
    if (m.role === "assistant" && m.streaming) div.classList.add("streaming-cursor");
    const pre = document.createElement("pre");
    pre.textContent = m.content;
    div.appendChild(pre);
    return div;
  }
  function appendMsg(m) {
    messages.push(m); SS("1kw-chat-msgs", messages);
    if (m.role !== "system") {
      const placeholder = msgEl.querySelector(".msg.system");
      if (placeholder) placeholder.remove();
    }
    msgEl.appendChild(renderMsg(m));
    msgEl.scrollTop = msgEl.scrollHeight;
    return msgEl.lastChild;
  }
  function updateLastAssistant(content, streaming) {
    const last = messages[messages.length - 1];
    if (!last || last.role !== "assistant") return;
    last.content = content;
    last.streaming = streaming;
    SS("1kw-chat-msgs", messages);
    const nodes = msgEl.children;
    const node = nodes[nodes.length - 1];
    if (node) {
      node.classList.toggle("streaming-cursor", !!streaming);
      node.querySelector("pre").textContent = content;
      msgEl.scrollTop = msgEl.scrollHeight;
    }
  }

  // -------- API --------
  async function checkHealth() {
    try {
      const base = cfg.apiUrl.replace(/\/v1\/?$/, "");
      const r = await fetch(base + "/health", { cache: "no-store" });
      statusEl.textContent = r.ok ? "已連線" : "服務異常";
      statusEl.className = r.ok ? "online" : "offline";
      return r.ok;
    } catch (e) {
      statusEl.textContent = "離線";
      statusEl.className = "offline";
      return false;
    }
  }
  async function loadModels() {
    try {
      const headers = cfg.apiKey ? { "Authorization": "Bearer " + cfg.apiKey } : {};
      const r = await fetch(cfg.apiUrl + "/models", { headers, cache: "no-store" });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const j = await r.json();
      models = (j.data || []).map(m => m.id);
      if (!cfg.model && models.length) cfg.model = models[0];
      modelEl.placeholder = models.length ? models.join(" / ") : "(輸入模型名)";
      modelEl.value = cfg.model;
    } catch (e) {
      // silently fail — manual input still works
    }
  }

  async function send() {
    if (streaming) return;
    const text = inputEl.value.trim();
    if (!text) return;
    inputEl.value = ""; inputEl.style.height = "auto";

    appendMsg({ role: "user", content: text });
    appendMsg({ role: "assistant", content: "", streaming: true });

    const body = {
      model: cfg.model || "default",
      messages: [
        ...(cfg.system ? [{ role: "system", content: cfg.system }] : []),
        ...messages.filter(m => m.role === "user" || m.role === "assistant").slice(0, -1).concat([{ role: "user", content: text }]),
      ],
      stream: true,
      temperature: parseFloat(cfg.temp) || 0.6,
      top_p: parseFloat(cfg.topp) || 0.95,
      max_tokens: parseInt(cfg.max, 10) || 4096,
    };
    const headers = { "Content-Type": "application/json" };
    if (cfg.apiKey) headers["Authorization"] = "Bearer " + cfg.apiKey;

    streaming = true; sendBtn.disabled = true;
    try {
      const r = await fetch(cfg.apiUrl + "/chat/completions", { method: "POST", headers, body: JSON.stringify(body) });
      if (!r.ok || !r.body) {
        const errText = await r.text().catch(() => "");
        updateLastAssistant("❌ " + r.status + " " + (errText || r.statusText), false);
        messages[messages.length - 1].role = "error";
        SS("1kw-chat-msgs", messages);
        msgEl.lastChild.className = "msg error";
        return;
      }
      const reader = r.body.getReader();
      const decoder = new TextDecoder();
      let buf = "", full = "";
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        let idx;
        while ((idx = buf.indexOf("\n")) >= 0) {
          const line = buf.slice(0, idx).trim();
          buf = buf.slice(idx + 1);
          if (!line.startsWith("data:")) continue;
          const data = line.slice(5).trim();
          if (data === "[DONE]") continue;
          try {
            const j = JSON.parse(data);
            const delta = j.choices?.[0]?.delta?.content || "";
            if (delta) { full += delta; updateLastAssistant(full, true); }
          } catch {}
        }
      }
      updateLastAssistant(full, false);
      checkHealth();
    } catch (e) {
      updateLastAssistant("❌ " + e.message, false);
      messages[messages.length - 1].role = "error";
      SS("1kw-chat-msgs", messages);
      msgEl.lastChild.className = "msg error";
    } finally {
      streaming = false; sendBtn.disabled = false;
    }
  }

  // -------- Events --------
  saveBtn.onclick = () => {
    cfg = {
      apiUrl: apiUrl.value.trim().replace(/\/+$/, "") || cfg.apiUrl,
      apiKey: apiKey.value.trim(),
      model: modelEl.value.trim(),
      temp: parseFloat(tempEl.value),
      topp: parseFloat(toppEl.value),
      max: parseInt(maxEl.value, 10),
      system: sysEl.value,
    };
    SS("1kw-chat-cfg", cfg);
    saveBtn.textContent = "✓ 儲存";
    setTimeout(() => saveBtn.textContent = "儲存", 1200);
    checkHealth(); loadModels();
  };
  clearBtn.onclick = () => {
    if (!confirm("清空所有對話？")) return;
    messages = []; SS("1kw-chat-msgs", []);
    renderMessages();
  };
  sendBtn.onclick = send;
  inputEl.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); }
  });
  inputEl.addEventListener("input", () => {
    inputEl.style.height = "auto";
    inputEl.style.height = Math.min(inputEl.scrollHeight, 140) + "px";
  });

  // -------- Boot --------
  loadCfg(); renderMessages();
  checkHealth(); loadModels();
  setInterval(checkHealth, 30000);

  // PWA: register service worker for "installable" feel (best-effort)
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js").catch(() => {});
  }
})();
</script>
</body>
</html>
